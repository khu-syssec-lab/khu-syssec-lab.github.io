---
layout: default
---
<div class="post">

  <header class="post-header">
    {% comment %} {% include social_header.html %} {% endcomment %}
    <h1 class="post-title">
    {% if page.sitetitle %}{{ site.title }}{% else %}{{ page.title }}{% endif %}
    </h1>
      {% comment %}<p class="post-description">{{ page.description }}</p>{% endcomment %}
  </header>

  <article>
    {% if page.profile %}
      {% comment %} <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %} {% endcomment %}
  <div class="profile profile-side float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% assign requested_image = page.profile.image | default: 'blank-profile.png' %}
        {% assign requested_path = 'assets/img/' | append: requested_image %}
        {% capture profile_image_exists %}{% file_exists {{ requested_path }} %}{% endcapture %}
        {% if profile_image_exists == 'true' %}
          {% assign profile_image_file = requested_image %}
        {% else %}
          {% assign profile_image_file = 'blank-profile.png' %}
        {% endif %}
        {% if page.profile.href %}<a href="{{ page.profile.href | relative_url }}">{% endif %}
          <img class="img-fluid{% assign ext = profile_image_file | slice: -4, 4 %}{% if ext != '.svg' %} z-depth-1 rounded{% endif %}" src="{{ profile_image_file | prepend: '/assets/img/' | relative_url }}" alt="{{ page.profile.name }}">
        {% if page.profile.href %}</a>{% endif %}
        <div class="address">
          <p class="profile-contact">
            {% if page.profile.email %}<a href="mailto:{{ page.profile.email }}"><i class="fas fa-envelope"></i> {{ page.profile.email }}</a>{% endif %}
            {% if page.profile.phone %}<br /><a href="tel:{{ page.profile.phone }}"><i class="fas fa-phone"></i> {{ page.profile.phone }}</a>{% endif %}
          </p>
          <p class="profile-icons">
            {% if page.profile.linkedin %}<a href="https://www.linkedin.com/in/{{ page.profile.linkedin }}/" target="_blank" title="LinkedIn" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>{% endif %}
            {% if page.profile.orcid %}<a href="https://orcid.org/{{ page.profile.orcid }}" target="_blank" title="ORCID" aria-label="ORCID"><i class="fab fa-orcid"></i></a>{% endif %}
            {% if page.profile.scholar %}<a href="https://scholar.google.com/citations?user={{ page.profile.scholar }}" target="_blank" title="Google Scholar" aria-label="Google Scholar"><i class="fas fa-graduation-cap"></i></a>{% endif %}
            {% if page.profile.twitter %}<a href="https://twitter.com/{{ page.profile.twitter }}" target="_blank" title="Twitter" aria-label="Twitter"><i class="fab fa-twitter"></i></a>{% endif %}
            {% if page.profile.github %}<a href="https://github.com/{{ page.profile.github }}" target="_blank" title="GitHub" aria-label="GitHub"><i class="fab fa-github"></i></a>{% endif %}
            {% if page.profile.website %}<a href="{{ page.profile.website }}" target="_blank" title="Website" aria-label="Website"><i class="fas fa-globe"></i></a>{% endif %}
            {% if page.profile.cv %}<a href="{{ page.profile.cv | relative_url }}" target="_blank" title="CV" aria-label="CV"><i class="fas fa-file-pdf"></i></a>{% endif %}
          </p>
          <p class="post">{{ page.profile.address }}</p>
        </div>
      </div>
      {% endif %}

    <div class="clearfix profile-body">
      {{ content }}
      {% include member_sections.liquid %}
    </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
